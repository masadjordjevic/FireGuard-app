# --- Database (dev: SQLite) ---
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Random secret used to sign session JWTs — generate your own, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# --- Sepolia deployment (Hardhat) ---
# RPC endpoint - get a free one from Alchemy or Infura
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"
# Private key of the wallet that will deploy & own the contract (funded with Sepolia test ETH)
# NEVER commit this or use a wallet with real funds
DEPLOYER_PRIVATE_KEY=""

CAMPAIGN_NAME="FireGuard Emergency Response Fund"
CAMPAIGN_GOAL_ETH="1"

# --- Frontend: address of the deployed DonationCampaign contract ---
NEXT_PUBLIC_DONATION_CONTRACT_ADDRESS=""
# Block number the contract was deployed at (printed by `npm run deploy:sepolia`) —
# tells the donation indexer where to start scanning for DonationReceived events.
DONATION_CONTRACT_DEPLOY_BLOCK=""
